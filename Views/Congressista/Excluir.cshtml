@model Congressista

@{
    // Define o título exibido no layout compartilhado.
    ViewData["Title"] = "Excluir congressista";
}

@* Confirma visualmente qual cadastro será removido. *@
<h1>Excluir congressista</h1>
<p>Confirma a exclusão de <strong>@Model.Nome</strong>?</p>

@* A exclusão é enviada por POST para evitar alteração de dados por um simples acesso GET. *@
<form asp-action="Excluir" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
