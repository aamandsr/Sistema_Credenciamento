@model IReadOnlyList<Congressista>

@{
    ViewData["Title"] = "Congressistas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Congressistas</h1>
    <a class="btn btn-primary" asp-action="Criar">Adicionar congressista</a>
</div>

@if (Model.Count == 0)
{
    <p>Nenhum congressista cadastrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Nome no crachá</th>
                    <th>Tipo</th>
                    <th>Pagamento</th>
                    <th>Material impresso</th>
                    <th>Empresa</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var congressista in Model)
                {
                    <tr>
                        <td>@congressista.Nome</td>
                        <td>@congressista.Nome_Cracha</td>
                        <td>@congressista.Tipo</td>
                        <td>@congressista.Pagamento</td>
                        <td>@(congressista.Material_Impresso ? "Sim" : "Não")</td>
                        <td>@congressista.Empresa</td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@congressista.Id">Editar</a>
                            <span class="mx-1">|</span>
                            <a asp-action="Excluir" asp-route-id="@congressista.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
