<!-- Configura a compilação do projeto ASP.NET Core MVC. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Define framework-alvo, nulabilidade e namespaces padrão do código C#. -->
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SistemaCredenciamento</AssemblyName>
    <RootNamespace>SistemaCredenciamento</RootNamespace>
    <UserSecretsId>SistemaCredenciamento-8dcb9bf5-7561-46ae-b91e-58dfe9ff2a3a</UserSecretsId>
  </PropertyGroup>

  <!-- Driver usado para conectar ao MySQL e executar comandos com ADO.NET. -->
  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.10.0" />
  </ItemGroup>

</Project>
